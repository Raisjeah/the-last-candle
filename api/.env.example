# The Last Candle - API Configuration
# Copy this file to .env and fill in your actual values

# API Configuration
REACT_APP_API_BASE_URL=https://api.example.com
REACT_APP_API_TIMEOUT=5000

# Market Data APIs
REACT_APP_BINANCE_API_URL=https://api.binance.com/api/v3
REACT_APP_BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Forex/Commodity APIs (optional)
REACT_APP_FOREX_API_URL=https://api.example.com/forex
REACT_APP_COMMODITY_API_URL=https://api.example.com/commodity
REACT_APP_FOREX_API_KEY=your_forex_api_key_here

# Authentication
REACT_APP_JWT_SECRET=your_jwt_secret_here
REACT_APP_JWT_EXPIRY=7d

# Push Notifications
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here
REACT_APP_VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Database (if using direct connection)
REACT_APP_DB_HOST=your_db_host
REACT_APP_DB_PORT=5432
REACT_APP_DB_NAME=the_last_candle
REACT_APP_DB_USER=your_db_user
REACT_APP_DB_PASSWORD=your_db_password

# Email Service (for notifications & reset password)
REACT_APP_SMTP_HOST=smtp.gmail.com
REACT_APP_SMTP_PORT=587
REACT_APP_SMTP_USER=your_email@gmail.com
REACT_APP_SMTP_PASSWORD=your_app_password

# Security
REACT_APP_ENABLE_HTTPS=true
REACT_APP_CORS_ORIGIN=https://example.com

# Feature Flags
REACT_APP_ENABLE_TRADING_TERMINAL=true
REACT_APP_ENABLE_AI_CHAT=true
REACT_APP_ENABLE_FORUM=true
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true

# Analytics (optional)
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_MIXPANEL_TOKEN=
